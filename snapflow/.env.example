# Copy to .env. Keep credentials on your own machine; do not commit them.
# Use the endpoint and a vision-capable model from your provider's console.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# Existing AgentM gateway: auto-detect api_key.json beside this application
# or in its parent folder. Set an explicit path only when stored elsewhere.
VISION_GATEWAY_CONFIG=
VISION_GATEWAY_MODEL=gemini-3.8-flash
# Dense chat screenshots can need more than 40 seconds; allowed range 10-300.
VISION_TIMEOUT_SECONDS=120
# To intentionally disable all model calls (e.g. isolated UI tests):
VISION_DISABLED=0

# Optional: application must have write access to this calendar.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CALENDAR_ID=

PORT=8765
